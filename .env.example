# Скопіюйте цей файл у .env поруч із compose.yaml і заповніть порожні значення.
# Файл .env не додають до Git.

# Команда, яку виконує сервіс certboot. Створює самопідписаний сертифікат
# і ключ у каталозі /certs контейнера.
CERT_GEN_COMMAND=openssl req -x509 -nodes -newkey rsa:2048 -days 365 -subj /CN=docker-compose.loc -addext subjectAltName=DNS:docker-compose.loc -keyout /certs/server.key -out /certs/server.crt

# Адреси API, які Vite вбудовує у фронтенд під час збирання.
VITE_ARTICLES_URL=https://docker-compose.loc/api/articles
VITE_USERS_URL=https://docker-compose.loc/api/users

# Параметри бази даних.
DB_NAME=mydb
DB_USER=app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
